# ---- SRE Starter Kit configuration ----
# Copy to .env (or run `make init`). Every variable below is required unless marked optional.

PROJECT_NAME=myproject                 # label attached to every metric/alert

# --- Network exposure ---
# 0.0.0.0 exposes unauthenticated Prometheus, Alertmanager and Loki to your network;
# use an SSH tunnel or reverse proxy instead.
BIND_ADDR=127.0.0.1
ALERTMANAGER_EXTERNAL_URL=http://localhost:9093   # the link on every alert; the URL your team opens Alertmanager at (SSH tunnel, VPN, reverse proxy)

# --- Alert receivers (at least one; Slack is no longer required) ---
SLACK_WEBHOOK_URL=                     # https://hooks.slack.com/services/...
DISCORD_WEBHOOK_URL=                   # https://discord.com/api/webhooks/...
TELEGRAM_BOT_TOKEN=                    # optional
TELEGRAM_CHAT_ID=                      # optional
TEAMS_WEBHOOK_URL=                     # optional, MS Teams Workflows webhook
ALERT_EMAIL_TO=                        # comma-separated addresses; needs the SMTP_* lines below
SMTP_HOST=                             # host:port with STARTTLS, e.g. smtp.gmail.com:587 or email-smtp.eu-west-1.amazonaws.com:587
SMTP_FROM=                             # e.g. alerts@example.com
SMTP_USER=                             # SMTP login; leave empty for an unauthenticated relay on your own network
SMTP_PASSWORD=                         # Gmail: an app password, not the account password

# --- AI triage (optional; `make init` asks) ---
# Add "triage" to COMPOSE_PROFILES and point the webhook at the agent to get a context pack per
# critical alert. With TRIAGE_DRY_RUN=true (default) the pack is only printed to the agent's log.
TRIAGE_WEBHOOK_URL=http://localhost:9/      # http://triage-agent:9096/alert when the profile is on
TRIAGE_DRY_RUN=true
# From your Gumroad purchase. With TRIAGE_DRY_RUN=true, empty keeps dry run; with
# TRIAGE_DRY_RUN=false, empty means the alert is dropped (no cloud configured).
TRIAGE_LICENSE_KEY=
# Hosted triage service URL, from your Gumroad purchase; empty behaves the same as an empty
# TRIAGE_LICENSE_KEY above.
TRIAGE_API_URL=
# Extra regexes to redact from logs, separated by ;;
TRIAGE_REDACT=

# --- Services to probe (blackbox HTTP) ---
# name=http://host:port/health,name2=http://host2:port/health
# Name each probe after its compose service name so logs and metrics line up in the dashboards.
SERVICES=

# --- Thresholds ---
DISK_WARN_PCT=15                       # warn when free disk % below this
DISK_CRIT_PCT=5                        # critical when free disk % below this

# --- Retention ---
PROM_RETENTION_TIME=15d
PROM_RETENTION_SIZE=20GB               # ~80% of the disk you give Prometheus
LOKI_RETENTION_PERIOD=168h             # 7 days

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=change-me

# --- Container runtime ---
CONTAINER_SOCK=/var/run/docker.sock   # Podman: /run/user/<uid>/podman/podman.sock
COMPOSE_PROFILES=cadvisor                # container metrics via cAdvisor. Podman: leave empty (cAdvisor needs /var/lib/docker)
# How Prometheus reaches node-exporter, which runs in the host network namespace so that its
# network counters describe this machine rather than a container (see README "Exposure").
# The default works on Docker. Rootful Podman: use the bridge gateway, e.g. 10.88.0.1:9100
# (`podman network inspect podman` prints it). Rootless Podman cannot reach it at all - see the
# README before you rely on host metrics there.
NODE_EXPORTER_TARGET=node-exporter:9100

# --- Security module ---
MODULE_SECURITY=true                   # SSH failed-login / root-login alerts from auth.log
AUTH_LOG_PATH=/var/log/auth.log        # Debian/Ubuntu. RHEL: /var/log/secure

# Disk sizing rule of thumb: ~1GB per host for 15d of metrics, ~2GB per service for 7d of logs.
